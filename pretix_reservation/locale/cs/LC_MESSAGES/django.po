#: apps.py:10 apps.py:13 apps.py:21
#: templates/pretix_reservation/settings.html:3
#: templates/pretix_reservation/settings.html:5
msgid "Reservation checkout"
msgstr "Rezervace objednávky"

#: apps.py:15
msgid "Allow customers to reserve an order without selecting a payment method."
msgstr "Umožní zákazníkům rezervovat objednávku bez výběru platební metody."

#: apps.py:21
msgid "Settings"
msgstr "Nastavení"

#: checkout.py:22
msgctxt "checkoutflow"
msgid "Payment timing"
msgstr "Termín platby"

#: checkout.py:32 checkout.py:45
msgid "Please choose whether you want to pay now or later."
msgstr "Zvolte prosím, zda chcete zaplatit nyní, nebo později."

#: forms.py:9
msgid "Enable reservation without payment"
msgstr "Povolit rezervaci bez platby"

#: forms.py:11
msgid "Customers can choose to create a pending reservation and select a payment method later."
msgstr "Zákazníci mohou vytvořit nezaplacenou rezervaci a platební metodu vybrat později."

#: templates/pretix_reservation/checkout_choice.html:4
msgid "When do you want to pay?"
msgstr "Kdy chcete zaplatit?"

#: templates/pretix_reservation/checkout_choice.html:10
msgid "Pay online"
msgstr "Zaplatit online"

#: templates/pretix_reservation/checkout_choice.html:11
msgid "Select a payment method and pay as part of checkout."
msgstr "Vyberte platební metodu a zaplaťte během dokončení objednávky."

#: templates/pretix_reservation/checkout_choice.html:15
msgid "Reserve and pay later"
msgstr "Rezervovat a zaplatit později"

#: templates/pretix_reservation/checkout_choice.html:16
msgid "Create an unpaid reservation. You can pay later online or at the box office."
msgstr "Vytvořte nezaplacenou rezervaci. Zaplatit můžete později online nebo na pokladně."

msgid "Create an unpaid reservation. You can choose a payment method later."
msgstr "Vytvořte nezaplacenou rezervaci. Platební metodu můžete vybrat později."

#: templates/pretix_reservation/checkout_choice.html:21
msgid "Go back"
msgstr "Zpět"

#: templates/pretix_reservation/checkout_choice.html:24
msgid "Continue"
msgstr "Pokračovat"

#: templates/pretix_reservation/confirm_notice.html:3
msgid "This order will be created as an unpaid reservation. You can pay later online or at the box office."
msgstr "Tato objednávka bude vytvořena jako nezaplacená rezervace. Zaplatit můžete později online nebo na pokladně."

#: templates/pretix_reservation/settings.html:10
msgid "Save"
msgstr "Uložit"
